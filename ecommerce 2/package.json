{
  "name": "nexacart-ai",
  "version": "1.0.0",
  "description": "NexaCart AI - Premium AI-Themed E-Commerce Platform",
  "scripts": {
    "install:server": "cd server && npm install",
    "install:client": "cd client && npm install",
